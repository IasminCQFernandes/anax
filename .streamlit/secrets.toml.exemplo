# Modelo dos Secrets. No Streamlit Cloud: abra o app > Settings > Secrets, cole o conteúdo preenchido e salve.
# Na sua máquina: copie para .streamlit/secrets.toml. Nunca suba o secrets.toml para o GitHub.

[login]
usuario = "iasmin"
nome = "Iasmin Fernandes"            # aparece no topo, nas notas e nas propostas
senha = "troque-por-uma-senha-forte"
horas = 12                           # quanto tempo o navegador fica conectado

[sql]
servidor = "34.95.193.32"
porta = 1433
banco = "UAU"
usuario = "usuario-de-leitura"
senha = "senha-do-usuario-sql"
criptografar = true
confiar_certificado = true
timeout = 15

# Onde o painel grava etapas, propostas, notas, taxas e documentos: Firestore do projeto anaxconsultoria.
# Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada. Abra o arquivo .json
# baixado, copie tudo (de { até }) e cole entre as aspas triplas:
[firebase_conta]
json = '''
{ cole aqui o conteúdo inteiro do arquivo .json }
'''
